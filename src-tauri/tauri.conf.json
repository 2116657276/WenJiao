{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "问筊",
  "version": "1.0.0",
  "identifier": "com.wenjiao.app",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "问筊",
        "width": 820,
        "height": 760,
        "minWidth": 680,
        "minHeight": 620,
        "maxWidth": 960,
        "maxHeight": 920,
        "resizable": true,
        "maximizable": false,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png"
    ]
  }
}
